within NISSA_12UCubeSat;
package Components "单机组件包"
  annotation(Documentation(info="<html><h4>包职责</h4><p><b>定位：</b>包含32个具有设备专业特性的白箱单机模型</p><p><b>内容：</b>32个model，均由MSL组件和少量Foundation核心通过connect组合</p><p><b>推荐阅读：</b>按电源、姿轨控、载荷、数管、通信、导航、热控和结构专业分组阅读</p><p><b>适用范围：</b>用于12U立方星多领域系统级总体仿真、架构理解、能量/热/姿态/任务联动和星上工程遥测导航。</p></html>"));
end Components;