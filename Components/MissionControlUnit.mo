  connect(resultMailbox.downlinkStartedOut,stateMachine.downlinkStartedEventId) annotation(Line(points={{54,-26},{50.5,-26},{50.5,50.5},{66,50.5},{66,62}},color={255,127,0},thickness=0.5));
  connect(resultMailbox.downlinkCompletedOut,stateMachine.downlinkCompletedEventId) annotation(Line(points={{54,-28},{50.5,-28},{50.5,50.5},{66,50.5},{66,60}},color={255,127,0},thickness=0.5));
  connect(resultMailbox.downlinkFailedOut,stateMachine.downlinkFailedEventId) annotation(Line(points={{54,-30},{50.5,-30},{50.5,50.5},{66,50.5},{66,58}},color={255,127,0},thickness=0.5));
  connect(resultMailbox.downlinkAbortedOut,stateMachine.downlinkAbortedEventId) annotation(Line(points={{54,-32},{50.5,-32},{50.5,50.5},{66,50.5},{66,56}},color={255,127,0},thickness=0.5));
  connect(resultMailbox.downlinkTimeoutOut,stateMachine.downlinkTimeoutEventId) annotation(Line(points={{54,-34},{50.5,-34},{50.5,50.5},{66,50.5},{66,54}},color={255,127,0},thickness=0.5));
  connect(resultMailbox.safeEntryCompleteOut,stateMachine.safeEntryCompleteEventId) annotation(Line(points={{44,-10},{82,-10},{82,52},{66,52}},color={255,127,0},thickness=0.5));
  connect(resultMailbox.recoveryCompleteOut,stateMachine.recoveryCompleteEventId) annotation(Line(points={{48,-10},{84,-10},{84,50},{66,50}},color={255,127,0},thickness=0.5));
  connect(adapter.command,command) annotation(Line(points={{86,-50},{86,0},{100,0}},color={120,70,150},thickness=0.5));
  connect(adapter.status,status) annotation(Line(points={{86,-62},{86,-34},{100,-34}},color={155,85,20},thickness=0.5));
  annotation(Icon(coordinateSystem(extent={{-100,-100},{100,100}},preserveAspectRatio=true),graphics={Rectangle(extent={{-100,100},{100,-100}},lineColor={95,65,145},fillColor={240,234,248},fillPattern=FillPattern.Solid),Rectangle(extent={{-70,46},{70,-42}},lineColor={95,65,145},fillColor={250,248,252},fillPattern=FillPattern.Solid),Line(points={{-54,22},{54,22}},color={95,65,145},thickness=2,arrow={Arrow.None,Arrow.Filled}),Line(points={{54,-14},{-54,-14}},color={20,105,125},thickness=2,arrow={Arrow.None,Arrow.Filled}),Text(extent={{-94,-76},{94,-52}},textString="MISSION / COMMAND")}),Diagram(coordinateSystem(extent={{-110,-110},{110,110}},preserveAspectRatio=true),graphics={Rectangle(extent={{-100,100},{100,-100}},lineColor={205,205,205},pattern=LinePattern.Dot),Rectangle(extent={{-96,84},{98,42}},lineColor={105,65,145},pattern=LinePattern.Dash),Text(extent={{-92,88},{92,80}},textString="OPPORTUNITY - PLAN - SAFETY - ARBITER - MISSION FSM"),Rectangle(extent={{-96,34},{98,-32}},lineColor={20,105,125},pattern=LinePattern.Dash),Text(extent={{-92,32},{92,25}},textString="PHYSICAL FEEDBACK - IMAGING / DOWNLINK / SAFE SEQUENCES"),Rectangle(extent={{36,-38},{98,-82}},lineColor={155,85,20},pattern=LinePattern.Dash),Text(extent={{40,-36},{94,-42}},textString="COMMAND + STATUS")}),Documentation(info="<html><h4>职责</h4><p>白箱连接原始机会、任务规划、安全监视、事件仲裁、任务状态机和三个动作时序器。</p><h4>信息路由</h4><p>每个内部接口只有一个生产者；请求、决策、状态动作请求和动作结果通过独立固定连接器单向传递。模型equation区仅含带Diagram annotation的connect语句。</p><h4>功能定位</h4><p>这是星务计算机内部的任务与指令控制白箱，负责把轨道机会、设备反馈、安全条件和当前任务状态组织为唯一的CommandBus、CommandStatusBus及活动任务选择。它不直接产生传感器遥测，也不替代OnboardComputerUnit中的状态数据库与工程遥测调度。</p><h4>内部职责链</h4><p>MissionOpportunityGenerator产生目标、地面站和日照机会；MissionPlanner提出成像/下传请求；SafetyMonitor形成安全约束；CommandArbiter按优先级仲裁；MissionStateMachine锁存任务阶段。Imaging、Downlink和SafeMode三个Sequencer执行动作时序，CommandAdapter把决策、状态与动作结果汇总为对外指令。</p><h4>接口与事件边界</h4><p>environment提供几何机会，device和payload提供物理反馈，command/status向设备和遥测链发布结果。共享机会信号经Boolean/Integer SignalReader进入MissionGeometryEventMailbox，邮箱以有限一次性交付边界切断同一事件迭代中的零时间因果环；Reader本身不延迟、不采样。</p><h4>使用方法与观察变量</h4><p>从Diagram按机会—规划—安全—仲裁—状态机—动作时序顺序追踪。重点查看stateMachine当前阶段、activeMissionSelection、command中的模式/成像/发射指令、status中的请求结果及各Sequencer事件号。分析失败任务时先区分未产生机会、被安全条件拒绝、动作超时或物理反馈未完成。</p><h4>建模边界</h4><p>本模型表示任务级OBC逻辑，不模拟线程、总线报文、CPU指令、操作系统调度和链路协议。所有组件间equation均为带图形注释的connect，算法与离散状态保留在Foundation.Models黑箱中。</p></html>"));
end MissionControlUnit;
