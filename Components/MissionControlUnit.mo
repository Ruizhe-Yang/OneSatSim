  connect(downlinkSequencer.completedEventId,resultMailbox.downlinkCompletedIn) annotation(Line(points={{34,16},{42,16},{42,-10},{54,-10},{54,-18}},color={255,127,0},thickness=0.5));
  connect(downlinkSequencer.failedEventId,resultMailbox.downlinkFailedIn) annotation(Line(points={{34,14},{44,14},{44,-12},{54,-12},{54,-20}},color={255,127,0},thickness=0.5));
