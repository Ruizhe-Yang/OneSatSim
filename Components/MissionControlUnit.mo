within OneSatSim.Components;
model MissionControlUnit "星务任务与指令控制组件"
  parameter Boolean operationalSnapshotStart=true "配置项 operationalSnapshotStart" ;
  parameter OneSatSim.Foundation.Types.ImagingCapabilities imagingCapabilities
    "成像Capabilities；Earth-camera capability from spacecraft design configuration";
  Foundation.Interfaces.EnvironmentPort environment  "外部环境接口或实例" annotation(Placement(visible=true, transformation(origin={-725,365}, extent={{-12,-12},{12,12}}, rotation=0), iconVisible=true, iconTransformation(origin={-89,80}, extent={{-12,-12},{12,12}}, rotation=0)));
  Foundation.Interfaces.DeviceStatusBus device  "计算/接口量 device" annotation(Placement(visible=true, transformation(origin={-725,145}, extent={{-12,-12},{12,12}}, rotation=0), iconVisible=true, iconTransformation(origin={89,80}, extent={{-12,-12},{12,12}}, rotation=0)));
  Foundation.Interfaces.PayloadDataPort payload  "计算/接口量 payload" annotation(Placement(visible=true, transformation(origin={-725,-15}, extent={{-12,-12},{12,12}}, rotation=0), iconVisible=true, iconTransformation(origin={89,48}, extent={{-12,-12},{12,12}}, rotation=0)));
