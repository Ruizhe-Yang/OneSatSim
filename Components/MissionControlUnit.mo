  Foundation.Interfaces.ActiveMissionSelectionOutput activeMissionSelection  "来自OBC的任务对象锁存索引" annotation(Placement(visible=true, transformation(origin={920,345}, extent={{-12,-12},{12,12}}, rotation=0), iconVisible=true, iconTransformation(origin={89,-48}, extent={{-12,-12},{12,12}}, rotation=0)));
  Foundation.Models.MissionOpportunityGenerator opportunity(
    imagingCapabilities=imagingCapabilities)  "原始机会与活动对象几何生成器实例" annotation(Placement(visible=true, transformation(origin={-580,365}, extent={{-62,-62},{62,62}}, rotation=0)));
  Foundation.Models.MissionPlanner planner  "对象感知的任务规划器实例" annotation(Placement(visible=true, transformation(origin={-270,355}, extent={{-65,-65},{65,65}}, rotation=0)));
  Foundation.Models.SafetyMonitor safety  "带回差的任务安全许可监视器实例" annotation(Placement(visible=true, transformation(origin={-270,110}, extent={{-62,-62},{62,62}}, rotation=0)));
  Foundation.Models.CommandArbiter arbiter  "任务请求的单入口事件锁存仲裁器实例" annotation(Placement(visible=true, transformation(origin={15,355}, extent={{-65,-65},{65,65}}, rotation=0)));
  Foundation.Models.MissionStateMachine stateMachine(operationalSnapshotStart=operationalSnapshotStart,
    imagingCapabilities=imagingCapabilities)  "单向动作握手的事件驱动任务状态机实例" annotation(Placement(visible=true, transformation(origin={335,325}, extent={{-80,-80},{80,80}}, rotation=0)));
  Foundation.Models.MissionFeedbackAdapter physicalFeedback  "物理状态到任务反馈的选择适配器实例" annotation(Placement(visible=true, transformation(origin={-580,115}, extent={{-58,-58},{58,58}}, rotation=0)));
  Foundation.Models.ImagingSequencer imagingSequencer(
    imagingCapabilities=imagingCapabilities)  "请求驱动的成像动作时序器实例" annotation(Placement(visible=true, transformation(origin={150,-180}, extent={{-65,-65},{65,65}}, rotation=0)));
  Foundation.Models.DownlinkSequencer downlinkSequencer  "请求驱动的下行动作时序器实例" annotation(Placement(visible=true, transformation(origin={355,-180}, extent={{-65,-65},{65,65}}, rotation=0)));
  Foundation.Models.SafeModeSequencer safeSequencer  "请求驱动的安全进入、保持与恢复时序器实例" annotation(Placement(visible=true, transformation(origin={570,-180}, extent={{-62,-62},{62,62}}, rotation=0)));
  Foundation.Models.MissionActionResultMailbox resultMailbox  "任务动作结果事件邮箱实例" annotation(Placement(visible=true, transformation(origin={535,125}, extent={{-60,-60},{60,60}}, rotation=0)));
  Foundation.Models.MissionActionRequestMailbox requestMailbox  "任务动作请求事件邮箱实例" annotation(Placement(visible=true, transformation(origin={325,65}, extent={{-58,-58},{58,58}}, rotation=0)));
  Foundation.Models.MissionGeometryEventMailbox geometryMailbox  "活动目标几何事件邮箱实例" annotation(Placement(visible=true, transformation(origin={-70,-150}, extent={{-58,-58},{58,58}}, rotation=0)));
  Foundation.Models.CommandAdapter adapter  "任务接口到设备指令与状态的纯映射实例" annotation(Placement(visible=true, transformation(origin={770,180}, extent={{-72,-72},{72,72}}, rotation=0)));
