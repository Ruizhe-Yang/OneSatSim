    "计算/接口量 thermistorValidity；CALCULATED validity mask; false channels are 293.15 K interface placeholders" annotation(Placement(visible=true, transformation(origin={340,-365}, extent={{-22,-22},{22,22}}, rotation=0)));
  Modelica.Electrical.Analog.Basic.Resistor boardLoad(R=boardLoadResistance,useHeatPort=true)  "board负载" annotation(Placement(visible=true, transformation(origin={-300,280}, extent={{-24,-24},{24,24}}, rotation=0)));
  Modelica.Thermal.HeatTransfer.Components.HeatCapacitor boardNode(C=boardHeatCapacity,T(start=276.69,fixed=false))  "计算/接口量 boardNode" annotation(Placement(visible=true, transformation(origin={-300,-170}, extent={{-30,-30},{30,30}}, rotation=0)));
  Modelica.Thermal.HeatTransfer.Components.ThermalConductor baseplate(G=mountConductance)  "计算/接口量 baseplate" annotation(Placement(visible=true, transformation(origin={-150,-200}, extent={{-24,-24},{24,24}}, rotation=0)));
  Modelica.Thermal.HeatTransfer.Sensors.TemperatureSensor thermistor1  "计算/接口量 thermistor1" annotation(Placement(visible=true, transformation(origin={-150,-295}, extent={{-22,-22},{22,22}}, rotation=0)));
  Modelica.Mechanics.MultiBody.Parts.Body tcbBody(m=mass,r_CM={rcm_X,rcm_Y,rcm_Z},I_11=inertia_XX,I_22=inertia_YY,I_33=inertia_ZZ)  "tcb本体" annotation(Placement(visible=true, transformation(origin={-385,-275}, extent={{-30,-30},{30,30}}, rotation=0)));
