  Modelica.Blocks.Sources.IntegerConstant enabledDevice[9](each k=170)  "启用Device" annotation(Placement(visible=true, transformation(origin={145,260}, extent={{-22,-22},{22,22}}, rotation=0)));
  Modelica.Blocks.Sources.IntegerConstant backupStandby(k=0)  "计算/接口量 backupStandby" annotation(Placement(visible=true, transformation(origin={260,260}, extent={{-22,-22},{22,22}}, rotation=0)));
  Modelica.Blocks.Sources.Constant inactiveCurrent[5](each k=0)  "未激活电流" annotation(Placement(visible=true, transformation(origin={150,-260}, extent={{-22,-22},{22,22}}, rotation=0)));
  Modelica.Blocks.Sources.Constant unmodeledThermistorPlaceholder[12](each k=293.15)
    "计算/接口量 unmodeledThermistorPlaceholder；UNMODELED placeholders only; see THERMISTOR_MODELING_AUDIT.md" annotation(Placement(visible=true, transformation(origin={150,-335}, extent={{-22,-22},{22,22}}, rotation=0)));
  Modelica.Blocks.Sources.BooleanConstant thermistorValidity[32](k={
    true,false,true,false,false,true,true,false,
    false,true,true,false,false,true,false,false,
    false,false,false,true,true,true,true,true,
