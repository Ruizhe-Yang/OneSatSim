within OneSatSim.Simulation;
model OrbitalEnvironment "Embedded generated ephemeris and mission geometry"
  parameter OneSatSim.Scenarios.OrbitConfig orbit "真实历元轨道输入及生成环境资源" ;
  parameter OneSatSim.Scenarios.GroundStationConfig groundStations[8] "最多8个地面站" ;
  parameter OneSatSim.Scenarios.ImagingTargetConfig imagingTargets[32] "最多32个拍摄目标" ;
  parameter Modelica.Units.SI.Time targetPredictionHorizon=84 "目标PredictionHorizon [s]" ;
  parameter Modelica.Units.SI.Time earlyTargetPredictionHorizon=180 "early目标PredictionHorizon [s]" ;
  OneSatSim.Foundation.Interfaces.EnvironmentPort environment 
     "外部环境接口或实例" annotation(Placement(transformation(origin={340,0},
extent={{-12,-12},{12,12}}),
iconTransformation(origin={88,4},
extent={{-12,-12},{12,12}}),
iconVisible=true));
  OneSatSim.Foundation.Models.EphemerisEnvironmentReader ephemerisReader(
    simulationDuration=orbit.simulationDuration,tableRows=orbit.environmentTableRows) 
     "固化星历表读取装配实例" annotation(Placement(visible=true, transformation(origin={-250,-10}, extent={{-60,-60},{60,60}}, rotation=0)));
  OneSatSim.Foundation.Models.OrbitalGeometry geometry(
    orbit=orbit,groundStations=groundStations,imagingTargets=imagingTargets,
    targetPredictionHorizon=targetPredictionHorizon,
    earlyTargetPredictionHorizon=earlyTargetPredictionHorizon) 
     "真实历元轨道、多地面站与多目标环境核心实例" annotation(Placement(visible=true, transformation(origin={-20,0}, extent={{-100,-100},{100,100}}, rotation=0)));
  Foundation.Interfaces.RealSignalBridge informationRealBridge[62]  "实数因果输出到可扩展信息总线的无状态恒等桥实例" annotation(Placement(visible=true, transformation(origin={190,105}, extent={{-16,-16},{16,16}}, rotation=0)));
  Foundation.Interfaces.IntegerSignalBridge informationIntegerBridge[5]  "整数因果输出到可扩展信息总线的无状态恒等桥实例" annotation(Placement(visible=true, transformation(origin={190,0}, extent={{-16,-16},{16,16}}, rotation=0)));
  Foundation.Interfaces.BooleanSignalBridge informationBooleanBridge[16]  "布尔因果输出到可扩展信息总线的无状态恒等桥实例" annotation(Placement(visible=true, transformation(origin={190,-105}, extent={{-16,-16},{16,16}}, rotation=0)));
  Foundation.Interfaces.MissionSelectionReader activeSelectionReader  "环境总线到窄任务选择输入的无状态适配器实例" annotation(Placement(transformation(origin={-130,-135}, extent={{-16,-16},{16,16}})));
