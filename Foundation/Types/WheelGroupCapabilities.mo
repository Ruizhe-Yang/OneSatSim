within OneSatSim.Foundation.Types;
record WheelGroupCapabilities "Four-wheel physical capability derived from the effective design configuration"
  parameter Modelica.Units.SI.Inertia J[4] "配置项 J；X/Y/Z/S rotor inertia";
  parameter Modelica.Units.SI.Torque maxTorque[4] "飞轮最大轴力矩；Excel单位N·m，当前设计基线 [N.m]；Symmetric positive and negative shaft torque limits";
  parameter Modelica.Units.SI.AngularVelocity maxSpeed[4] "max速度 [rad/s]；Absolute rotor speed limits";
  parameter Real axes[3,4] "配置项 axes；Unit mounting axes in the spacecraft body frame; columns X/Y/Z/S";
  annotation(Documentation(info="<html><h2>飞轮GroupCapabilities</h2><p><b>类路径：</b><code>OneSatSim.Foundation.Types.WheelGroupCapabilities</code>　<b>类型：</b>record</p><h3>用途与定位</h3><p>飞轮GroupCapabilities。原源码功能描述：Four-wheel physical capability derived from the effective design configuration</p><h3>配置与调用</h3><p>由使用者声明或传入本类型；记录与常量保存静态配置，不单独代表一套物理状态。修改设计输入后应通过项目既有离线配置入口生成生效快照。</p><h3>配置与参数</h3><p>下面列出当前源码表达式，仅用于阅读；当前参数对话框、生效配置记录与原有配置工具仍是使用依据。本页不新增默认值或换算。</p><table border=\"1\" cellspacing=\"0\" cellpadding=\"5\"><tr><th>参数</th><th>类型</th><th>用途</th><th>源码表达式</th></tr><tr><td><code>J[4]</code></td><td>Modelica.Units.SI.Inertia</td><td>配置项 J；X/Y/Z/S rotor inertia</td><td><code>由调用方、继承或默认声明提供</code></td></tr><tr><td><code>maxTorque[4]</code></td><td>Modelica.Units.SI.Torque</td><td>飞轮最大轴力矩；Excel单位N·m，当前设计基线 [N.m]；Symmetric positive and negative shaft torque limits</td><td><code>由调用方、继承或默认声明提供</code></td></tr><tr><td><code>maxSpeed[4]</code></td><td>Modelica.Units.SI.AngularVelocity</td><td>max速度 [rad/s]；Absolute rotor speed limits</td><td><code>由调用方、继承或默认声明提供</code></td></tr><tr><td><code>axes[3,4]</code></td><td>Real</td><td>配置项 axes；Unit mounting axes in the spacecraft body frame; columns X/Y/Z/S</td><td><code>由调用方、继承或默认声明提供</code></td></tr></table></html>"),
