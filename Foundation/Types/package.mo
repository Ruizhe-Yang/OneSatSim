within NISSA_12UCubeSat.Foundation;
package Types "类型与遥测目录包"
  extends Modelica.Icons.TypesPackage;
  annotation(Documentation(info="<html><h4>包职责</h4><p><b>定位：</b>保存遥测包编号、类型和长度等静态目录</p><p><b>内容：</b>TelemetryCatalog</p><p><b>推荐阅读：</b>与OnboardTelemetryPort和TelemetryScheduler对照阅读</p><p><b>适用范围：</b>用于12U立方星多领域系统级总体仿真、架构理解、能量/热/姿态/任务联动和星上工程遥测导航。</p></html>"));
end Types;