within OneSatSim.Foundation;
package Models "必要方程核心包"
  annotation(Documentation(info="<html><h4>包职责</h4><p><b>定位：</b>集中放置不能用纯MSL连接图清晰表达的轨道、任务控制、等效姿控和少数数据映射核心。</p><p><b>实现原则：</b>生产任务时序由OnboardMissionControllerCore唯一实现；不再保留旧兼容时间线。</p><p><b>推荐阅读：</b>OrbitalEnvironmentCore、OnboardMissionControllerCore、EquivalentAOCSCore。</p><p><b>适用范围：</b>12U立方星多领域系统级总体仿真。</p></html>"));
end Models;
