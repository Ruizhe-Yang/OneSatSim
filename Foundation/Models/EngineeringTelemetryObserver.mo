  Modelica.Blocks.Interfaces.RealOutput SAT_S1_thermistor_degCPublisher[20] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput SAT_S2_wheel_rpmPublisher[4] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput SAT_S2_wheel_APublisher[4] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
