  Modelica.Blocks.Interfaces.IntegerOutput StarTrackerY_statusPublisher  "计算/接口量 StarTrackerY_statusPublisher" annotation(Placement(visible=true, transformation(origin={-20,-83}, extent={{-6,-6},{6,6}}, rotation=0), iconVisible=true, iconTransformation(origin={-80,95}, extent={{-3.657143,-3.657143},{3.657143,3.657143}}, rotation=90)));
  Modelica.Blocks.Interfaces.IntegerOutput StarTrackerZ_statusPublisher  "计算/接口量 StarTrackerZ_statusPublisher" annotation(Placement(visible=true, transformation(origin={-20,-104}, extent={{-6,-6},{6,6}}, rotation=0), iconVisible=true, iconTransformation(origin={-89,80}, extent={{-3.413333,-3.413333},{3.413333,3.413333}}, rotation=180)));
equation
  SAT_S0_busVoltage_VPublisher=live.device.busVoltage;
  SAT_S0_busCurrent_APublisher=live.device.busCurrent;
  SAT_S0_subArray_VPublisher=live.device.subArrayVoltage;
  SAT_S0_MPPT_VPublisher=live.device.mpptVoltage;
  SAT_S0_MPPT_APublisher=live.device.mpptCurrent;
  SAT_S0_batteryCurrent_APublisher=live.device.pdCurrent[22];
  SAT_S0_batteryVoltage_VPublisher=live.device.batteryVoltage;
  SAT_S0_batterySOCPublisher=live.device.batterySOC;

  for i in 1:20 loop
    SAT_S1_thermistor_degCPublisher[i]=live.device.thermistorTemperature[thermistorMap[i]]-273.15;
  end for;

  SAT_S2_wheel_rpmPublisher=live.device.wheelSpeed*60/(2*Modelica.Constants.pi);
  SAT_S2_wheel_APublisher=live.device.wheelCurrent;
  SAT_S2_wheelStatusPublisher=live.device.wheelStatus;
  for i in 1:4 loop
    SAT_S2_starY_qPublisher[i]=live.device.starQuaternion[1,i];
    SAT_S2_starZ_qPublisher[i]=live.device.starQuaternion[2,i];
  end for;
  for j in 1:2 loop
    starQuaternionNormError[j]=abs(sum(live.device.starQuaternion[j,i]^2 for i in 1:4)-1);
    starQuaternionValid[j]=starQuaternionNormError[j] <= 1e-3 and 
      max(abs(live.device.starQuaternion[j,i]) for i in 1:4) <= 1+1e-6;
  end for;
  for i in 1:3 loop
    SAT_S2_starY_w_deg_sPublisher[i]=live.device.starAngularVelocity[1,i]*180/Modelica.Constants.pi;
    SAT_S2_starZ_w_deg_sPublisher[i]=live.device.starAngularVelocity[2,i]*180/Modelica.Constants.pi;
  end for;
  SAT_S2_YH50_deg_sPublisher=live.device.yh50Rate*180/Modelica.Constants.pi;
  SAT_S2_GNSS_position_mPublisher=live.device.gnssPosition;
  SAT_S2_GNSS_velocity_m_sPublisher=live.device.gnssVelocity;
  SAT_S2_magneticField_GaussPublisher=live.device.magneticField*1e4;
  for i in 1:3 loop
    SAT_S2_MEMS_gyro_deg_sPublisher[i]=live.device.mems[i]*180/Modelica.Constants.pi;
    SAT_S2_MEMS_accel_m_s2Publisher[i]=live.device.mems[i+3];
  end for;
  SAT_S2_sunAngle_degPublisher=live.device.sunAngle*180/Modelica.Constants.pi;

  SAT_S3_commandErrorCountPublisher=live.device.commandErrorCount;
  SAT_S3_watchdogCountPublisher=live.device.watchdogCount;
  SAT_S3_bootSecondsPublisher=noEvent(integer(time));
  SAT_S3_millisecondsPublisher=noEvent(integer(mod(time,1)*1000));
  SAT_S3_cpuTemperature_degCPublisher=live.device.cpuTemperature-273.15;
  SAT_S3_boardTemperature_degCPublisher=live.device.boardTemperature-273.15;
  SAT_S3_missionModePublisher=Integer(live.commandStatus.missionMode);
  SAT_S3_controlModePublisher=Integer(live.commandStatus.controlMode);
  SAT_S3_commandTypePublisher=Integer(live.commandStatus.currentCommand);
  SAT_S3_commandExecutionStatusPublisher=Integer(live.commandStatus.executionStatus);
  SAT_S3_rejectReasonPublisher=Integer(live.commandStatus.rejectReason);
  SAT_S3_commandIdPublisher=live.commandStatus.commandId;
  SAT_S3_transitionCounterPublisher=live.commandStatus.transitionCounter;
  SAT_S3_executionTime_sPublisher=live.commandStatus.executionTime;
  SAT_S3_commandAcceptedPublisher=live.commandStatus.accepted;
  SAT_S3_commandRejectedPublisher=live.commandStatus.rejected;
  SAT_S3_commandExecutingPublisher=live.commandStatus.executing;
  SAT_S3_commandCompletedPublisher=live.commandStatus.completed;
  SAT_S3_commandFailedPublisher=live.commandStatus.failed;
  SAT_S3_commandAbortedPublisher=live.commandStatus.aborted;
  SAT_S3_commandTimeoutPublisher=live.commandStatus.timeout;
  SAT_S3_imagingOpportunityPublisher=live.commandStatus.imagingOpportunity;
  SAT_S3_downlinkOpportunityPublisher=live.commandStatus.downlinkOpportunity;
  SAT_S3_imagingAllowedPublisher=live.commandStatus.imagingAllowed;
  SAT_S3_downlinkAllowedPublisher=live.commandStatus.downlinkAllowed;
  SAT_S3_safeModeRequiredPublisher=live.commandStatus.safeModeRequired;
  SAT_S3_usedStorage_MBPublisher=live.payload.storedBytes/1e6;
  SAT_S3_remainingStorage_MBPublisher=live.payload.remainingBytes/1e6;
  SAT_S3_attitudeError_degPublisher=live.device.attitudeError*180/Modelica.Constants.pi;
  SAT_S3_attitudeSettledPublisher=live.device.attitudeSettled;
  SAT_S3_imagingCaptureStartedPublisher=live.commandStatus.imagingCaptureStarted;
  SAT_S3_imagingImageCompletePublisher=live.commandStatus.imagingImageComplete;
  SAT_S3_imagingValidImageBytesPublisher=live.commandStatus.imagingValidImageBytes;
  SAT_S3_imagingFailureReasonPublisher=Integer(live.commandStatus.imagingFailureReason);

  PDB_S0_channelStatePublisher=live.device.pdState;
  PDB_S0_channelCurrent_APublisher=live.device.pdCurrent;
  TCB_S0_channelStatePublisher=live.device.tcState;
  TCB_S0_channelCurrent_APublisher=live.device.tcCurrent;
  TCB_S0_heaterUpper_degCPublisher=live.device.heaterUpper-fill(273.15,14);
  TCB_S0_heaterLower_degCPublisher=live.device.heaterLower-fill(273.15,14);
  TCB_S0_thermistor_degCPublisher=live.device.thermistorTemperature-fill(273.15,32);

  GNSS_fixPublisher=live.device.gnssFix;
  Camera_statusPublisher=live.device.cameraStatus;
  Baseband_statusPublisher=live.device.basebandStatus;
  TTC_statusPublisher=live.device.ttcStatus;
  StarTrackerY_statusPublisher=live.device.starStatus[1];
  StarTrackerZ_statusPublisher=live.device.starStatus[2];
  SOLAR_netDeliveredPower_WPublisher=sum(live.device.solarOutputPower);
  POWER_threeRailOutputPower_WPublisher=live.device.threeRailOutputPower;
  BMS_chargeAllowedPublisher=live.device.batteryChargeAllowed;
  THERM_transmitter_degCPublisher=live.device.transmitterTemperature-273.15;
  ATT_starY_validPublisher=starQuaternionValid[1] and live.device.starStatus[1] > 0;
  DATA_storedBytesPublisher=live.payload.storedBytes;
  DATA_acceptedWriteRate_B_sPublisher=live.payload.acceptedEarthCameraWriteRate+
    live.payload.acceptedSelfieWriteRate;
  DATA_actualReadRate_B_sPublisher=live.payload.actualDownlinkReadRate;
  MISSION_targetIndexPublisher=live.command.targetIndex;
  MISSION_stationIndexPublisher=live.command.groundStationIndex;
  MISSION_completedImagingCountPublisher=live.commandStatus.completedImagingCount;
  MISSION_completedDownlinkCountPublisher=live.commandStatus.completedDownlinkCount;
  MISSION_lastCompletedTargetIndexPublisher=live.commandStatus.lastCompletedTargetIndex;
  MISSION_lastTerminalRequestIdPublisher=live.commandStatus.lastTerminalRequestId;
  MISSION_lastTerminalReasonCodePublisher=Integer(live.commandStatus.lastTerminalReason);
  TRANSMITTER_statusPublisher=live.device.transmitterStatus;
  connect(SOLAR_netDeliveredPower_WPublisher,telemetry.SOLAR_netDeliveredPower_W) annotation(Line(points={{345,245},{190,245},{190,0}}, color={0,0,127}, thickness=0.35, pattern=LinePattern.Solid, smooth=Smooth.None));
  connect(POWER_threeRailOutputPower_WPublisher,telemetry.POWER_threeRailOutputPower_W) annotation(Line(points={{345,224},{190,224},{190,0}}, color={0,0,127}, thickness=0.35, pattern=LinePattern.Solid, smooth=Smooth.None));
  connect(BMS_chargeAllowedPublisher,telemetry.BMS_chargeAllowed) annotation(Line(points={{345,203},{190,203},{190,0}}, color={255,0,255}, thickness=0.35, pattern=LinePattern.Solid, smooth=Smooth.None));
  connect(THERM_transmitter_degCPublisher,telemetry.THERM_transmitter_degC) annotation(Line(points={{190,-115},{138.2,-115},{138.2,0},{190,0}}, color={0,0,127}, thickness=0.35, pattern=LinePattern.Solid, smooth=Smooth.None));
  connect(ATT_starY_validPublisher,telemetry.ATT_starY_valid) annotation(Line(points={{-20,295},{190,295},{190,0}}, color={255,0,255}, thickness=0.35, pattern=LinePattern.Solid, smooth=Smooth.None));
  connect(DATA_storedBytesPublisher,telemetry.DATA_storedBytes) annotation(Line(points={{-20,-185},{135,-185},{135,0},{190,0}}, color={0,0,127}, thickness=0.35, pattern=LinePattern.Solid, smooth=Smooth.None));
  connect(DATA_acceptedWriteRate_B_sPublisher,telemetry.DATA_acceptedWriteRate_B_s) annotation(Line(points={{-20,-207},{135,-207},{135,0},{190,0}}, color={0,0,127}, thickness=0.35, pattern=LinePattern.Solid, smooth=Smooth.None));
  connect(DATA_actualReadRate_B_sPublisher,telemetry.DATA_actualReadRate_B_s) annotation(Line(points={{-20,-229},{135,-229},{135,0},{190,0}}, color={0,0,127}, thickness=0.35, pattern=LinePattern.Solid, smooth=Smooth.None));
  connect(MISSION_targetIndexPublisher,telemetry.MISSION_targetIndex) annotation(Line(points={{355,-110},{250,-110},{250,0},{190,0}}, color={255,127,0}, thickness=0.35, pattern=LinePattern.Solid, smooth=Smooth.None));
  connect(MISSION_stationIndexPublisher,telemetry.MISSION_stationIndex) annotation(Line(points={{355,-132},{250,-132},{250,0},{190,0}}, color={255,127,0}, thickness=0.35, pattern=LinePattern.Solid, smooth=Smooth.None));
  connect(MISSION_completedImagingCountPublisher,telemetry.MISSION_completedImagingCount) annotation(Line(points={{355,-154},{250,-154},{250,0},{190,0}}, color={255,127,0}, thickness=0.35, pattern=LinePattern.Solid, smooth=Smooth.None));
  connect(MISSION_completedDownlinkCountPublisher,telemetry.MISSION_completedDownlinkCount) annotation(Line(points={{355,-176},{250,-176},{250,0},{190,0}}, color={255,127,0}, thickness=0.35, pattern=LinePattern.Solid, smooth=Smooth.None));
  connect(MISSION_lastCompletedTargetIndexPublisher,telemetry.MISSION_lastCompletedTargetIndex) annotation(Line(points={{355,-198},{250,-198},{250,0},{190,0}}, color={255,127,0}, thickness=0.35, pattern=LinePattern.Solid, smooth=Smooth.None));
  connect(MISSION_lastTerminalRequestIdPublisher,telemetry.MISSION_lastTerminalRequestId) annotation(Line(points={{355,-220},{250,-220},{250,0},{190,0}}, color={255,127,0}, thickness=0.35, pattern=LinePattern.Solid, smooth=Smooth.None));
