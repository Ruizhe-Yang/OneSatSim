  Modelica.Blocks.Interfaces.RealOutput SAT_S0_charger_VPublisher[2] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput SAT_S0_charger_APublisher[2] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
