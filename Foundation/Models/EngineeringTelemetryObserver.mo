  Modelica.Blocks.Interfaces.RealOutput SAT_S2_starZ_qPublisher[4] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput SAT_S2_starY_w_deg_sPublisher[3] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput SAT_S2_starZ_w_deg_sPublisher[3] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput SAT_S2_YH50_deg_sPublisher[3] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput SAT_S2_GNSS_position_mPublisher[3] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput SAT_S2_GNSS_velocity_m_sPublisher[3] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput SAT_S2_magneticField_GaussPublisher[3] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput SAT_S2_MEMS_gyro_deg_sPublisher[3] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput SAT_S2_MEMS_accel_m_s2Publisher[3] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput SAT_S2_sunAngle_degPublisher[2] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.IntegerOutput SAT_S3_commandErrorCountPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.IntegerOutput SAT_S3_watchdogCountPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.IntegerOutput SAT_S3_bootSecondsPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.IntegerOutput SAT_S3_millisecondsPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput SAT_S3_cpuTemperature_degCPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput SAT_S3_boardTemperature_degCPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.IntegerOutput SAT_S3_missionModePublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.IntegerOutput SAT_S3_controlModePublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.IntegerOutput SAT_S3_commandTypePublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.IntegerOutput SAT_S3_commandExecutionStatusPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.IntegerOutput SAT_S3_rejectReasonPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.IntegerOutput SAT_S3_commandIdPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.IntegerOutput SAT_S3_transitionCounterPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput SAT_S3_executionTime_sPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.BooleanOutput SAT_S3_commandAcceptedPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.BooleanOutput SAT_S3_commandRejectedPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.BooleanOutput SAT_S3_commandExecutingPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.BooleanOutput SAT_S3_commandCompletedPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.BooleanOutput SAT_S3_commandFailedPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.BooleanOutput SAT_S3_commandAbortedPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.BooleanOutput SAT_S3_commandTimeoutPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.BooleanOutput SAT_S3_imagingOpportunityPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.BooleanOutput SAT_S3_downlinkOpportunityPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.BooleanOutput SAT_S3_imagingAllowedPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.BooleanOutput SAT_S3_downlinkAllowedPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.BooleanOutput SAT_S3_safeModeRequiredPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput SAT_S3_usedStorage_MBPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput SAT_S3_remainingStorage_MBPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput SAT_S3_attitudeError_degPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.BooleanOutput SAT_S3_attitudeSettledPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.BooleanOutput SAT_S3_imagingCaptureStartedPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.BooleanOutput SAT_S3_imagingImageCompletePublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput SAT_S3_imagingValidImageBytesPublisher(unit="1") annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.IntegerOutput SAT_S3_imagingFailureReasonPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.IntegerOutput PDB_S0_channelStatePublisher[24] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput PDB_S0_channelCurrent_APublisher[24] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.IntegerOutput TCB_S0_channelStatePublisher[24] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput TCB_S0_channelCurrent_APublisher[24] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput TCB_S0_heaterUpper_degCPublisher[14] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput TCB_S0_heaterLower_degCPublisher[14] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.RealOutput TCB_S0_thermistor_degCPublisher[32] annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.IntegerOutput GNSS_fixPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.IntegerOutput Camera_statusPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.IntegerOutput Baseband_statusPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.IntegerOutput TTC_statusPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.IntegerOutput StarTrackerY_statusPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Modelica.Blocks.Interfaces.IntegerOutput StarTrackerZ_statusPublisher annotation(Placement(visible=false, transformation(extent={{-4,-4},{4,4}})));
  Foundation.Interfaces.RealSignalBridge informationRealBridge[199] annotation(Placement(transformation(extent={{58,-92},{66,-84}})));
  Foundation.Interfaces.IntegerSignalBridge informationIntegerBridge[70] annotation(Placement(transformation(extent={{70,-92},{78,-84}})));
  Foundation.Interfaces.BooleanSignalBridge informationBooleanBridge[15] annotation(Placement(transformation(extent={{82,-92},{90,-84}})));
equation
  SAT_S0_busVoltage_VPublisher=live.device.busVoltage;
  SAT_S0_busCurrent_APublisher=live.device.busCurrent;
  SAT_S0_subArray_VPublisher=live.device.subArrayVoltage;
  SAT_S0_MPPT_VPublisher=live.device.mpptVoltage;
  SAT_S0_MPPT_APublisher=live.device.mpptCurrent;
  SAT_S0_charger_VPublisher=live.device.chargerVoltage;
  SAT_S0_charger_APublisher=live.device.chargerCurrent;
  SAT_S0_batteryCurrent_APublisher=live.device.pdCurrent[22];
  SAT_S0_batteryVoltage_VPublisher=live.device.batteryVoltage;
  SAT_S0_batterySOCPublisher=live.device.batterySOC;

  for i in 1:20 loop
    SAT_S1_thermistor_degCPublisher[i]=live.device.thermistorTemperature[thermistorMap[i]]-273.15;
  end for;

  SAT_S2_wheel_rpmPublisher=live.device.wheelSpeed*60/(2*Modelica.Constants.pi);
  SAT_S2_wheel_APublisher=live.device.wheelCurrent;
  SAT_S2_wheelStatusPublisher=live.device.wheelStatus;
  for i in 1:4 loop
    SAT_S2_starY_qPublisher[i]=noEvent(max(-1,min(1,live.device.starQuaternion[1,i])));
    SAT_S2_starZ_qPublisher[i]=noEvent(max(-1,min(1,live.device.starQuaternion[2,i])));
  end for;
  for i in 1:3 loop
    SAT_S2_starY_w_deg_sPublisher[i]=live.device.starAngularVelocity[1,i]*180/Modelica.Constants.pi;
    SAT_S2_starZ_w_deg_sPublisher[i]=live.device.starAngularVelocity[2,i]*180/Modelica.Constants.pi;
  end for;
  SAT_S2_YH50_deg_sPublisher=live.device.yh50Rate*180/Modelica.Constants.pi;
  SAT_S2_GNSS_position_mPublisher=live.device.gnssPosition;
  SAT_S2_GNSS_velocity_m_sPublisher=live.device.gnssVelocity;
  SAT_S2_magneticField_GaussPublisher=live.device.magneticField*1e4;
  for i in 1:3 loop
    SAT_S2_MEMS_gyro_deg_sPublisher[i]=live.device.mems[i]*180/Modelica.Constants.pi;
    SAT_S2_MEMS_accel_m_s2Publisher[i]=live.device.mems[i+3];
  end for;
  SAT_S2_sunAngle_degPublisher=live.device.sunAngle*180/Modelica.Constants.pi;

  SAT_S3_commandErrorCountPublisher=live.device.commandErrorCount;
  SAT_S3_watchdogCountPublisher=live.device.watchdogCount;
  SAT_S3_bootSecondsPublisher=noEvent(integer(time));
  SAT_S3_millisecondsPublisher=noEvent(integer(mod(time,1)*1000));
  SAT_S3_cpuTemperature_degCPublisher=live.device.cpuTemperature-273.15;
  SAT_S3_boardTemperature_degCPublisher=live.device.boardTemperature-273.15;
  SAT_S3_missionModePublisher=Integer(live.commandStatus.missionMode);
  SAT_S3_controlModePublisher=Integer(live.commandStatus.controlMode);
  SAT_S3_commandTypePublisher=Integer(live.commandStatus.currentCommand);
  SAT_S3_commandExecutionStatusPublisher=Integer(live.commandStatus.executionStatus);
  SAT_S3_rejectReasonPublisher=Integer(live.commandStatus.rejectReason);
  SAT_S3_commandIdPublisher=live.commandStatus.commandId;
  SAT_S3_transitionCounterPublisher=live.commandStatus.transitionCounter;
  SAT_S3_executionTime_sPublisher=live.commandStatus.executionTime;
  SAT_S3_commandAcceptedPublisher=live.commandStatus.accepted;
  SAT_S3_commandRejectedPublisher=live.commandStatus.rejected;
  SAT_S3_commandExecutingPublisher=live.commandStatus.executing;
  SAT_S3_commandCompletedPublisher=live.commandStatus.completed;
  SAT_S3_commandFailedPublisher=live.commandStatus.failed;
  SAT_S3_commandAbortedPublisher=live.commandStatus.aborted;
  SAT_S3_commandTimeoutPublisher=live.commandStatus.timeout;
  SAT_S3_imagingOpportunityPublisher=live.commandStatus.imagingOpportunity;
  SAT_S3_downlinkOpportunityPublisher=live.commandStatus.downlinkOpportunity;
  SAT_S3_imagingAllowedPublisher=live.commandStatus.imagingAllowed;
  SAT_S3_downlinkAllowedPublisher=live.commandStatus.downlinkAllowed;
  SAT_S3_safeModeRequiredPublisher=live.commandStatus.safeModeRequired;
  SAT_S3_usedStorage_MBPublisher=live.payload.storedBytes/1e6;
  SAT_S3_remainingStorage_MBPublisher=live.payload.remainingBytes/1e6;
  SAT_S3_attitudeError_degPublisher=live.device.attitudeError*180/Modelica.Constants.pi;
  SAT_S3_attitudeSettledPublisher=live.device.attitudeSettled;
  SAT_S3_imagingCaptureStartedPublisher=live.commandStatus.imagingCaptureStarted;
  SAT_S3_imagingImageCompletePublisher=live.commandStatus.imagingImageComplete;
  SAT_S3_imagingValidImageBytesPublisher=live.commandStatus.imagingValidImageBytes;
  SAT_S3_imagingFailureReasonPublisher=Integer(live.commandStatus.imagingFailureReason);

  PDB_S0_channelStatePublisher=live.device.pdState;
  PDB_S0_channelCurrent_APublisher=live.device.pdCurrent;
  TCB_S0_channelStatePublisher=live.device.tcState;
  TCB_S0_channelCurrent_APublisher=live.device.tcCurrent;
  TCB_S0_heaterUpper_degCPublisher=live.device.heaterUpper-fill(273.15,14);
  TCB_S0_heaterLower_degCPublisher=live.device.heaterLower-fill(273.15,14);
  TCB_S0_thermistor_degCPublisher=live.device.thermistorTemperature-fill(273.15,32);

  GNSS_fixPublisher=live.device.gnssFix;
  Camera_statusPublisher=live.device.cameraStatus;
  Baseband_statusPublisher=live.device.basebandStatus;
  TTC_statusPublisher=live.device.ttcStatus;
  StarTrackerY_statusPublisher=live.device.starStatus[1];
  StarTrackerZ_statusPublisher=live.device.starStatus[2];
  connect(SAT_S0_busVoltage_VPublisher[1],informationRealBridge[1].u) annotation(Line(points={{78,-60},{102,-60},{102,0}},color={0,0,127}));
  connect(informationRealBridge[1].y,telemetry.SAT_S0_busVoltage_V[1]) annotation(Line(points={{78,-60},{102,-60},{102,0}},color={0,0,127}));
  connect(SAT_S0_busVoltage_VPublisher[2],informationRealBridge[2].u) annotation(Line(points={{78,-60},{102,-60},{102,0}},color={0,0,127}));
  connect(informationRealBridge[2].y,telemetry.SAT_S0_busVoltage_V[2]) annotation(Line(points={{78,-60},{102,-60},{102,0}},color={0,0,127}));
  connect(SAT_S0_busVoltage_VPublisher[3],informationRealBridge[3].u) annotation(Line(points={{78,-60},{102,-60},{102,0}},color={0,0,127}));
  connect(informationRealBridge[3].y,telemetry.SAT_S0_busVoltage_V[3]) annotation(Line(points={{78,-60},{102,-60},{102,0}},color={0,0,127}));
  connect(SAT_S0_busCurrent_APublisher[1],informationRealBridge[4].u) annotation(Line(points={{78,-50},{102,-50},{102,0}},color={0,0,127}));
  connect(informationRealBridge[4].y,telemetry.SAT_S0_busCurrent_A[1]) annotation(Line(points={{78,-50},{102,-50},{102,0}},color={0,0,127}));
  connect(SAT_S0_busCurrent_APublisher[2],informationRealBridge[5].u) annotation(Line(points={{78,-50},{102,-50},{102,0}},color={0,0,127}));
  connect(informationRealBridge[5].y,telemetry.SAT_S0_busCurrent_A[2]) annotation(Line(points={{78,-50},{102,-50},{102,0}},color={0,0,127}));
  connect(SAT_S0_busCurrent_APublisher[3],informationRealBridge[6].u) annotation(Line(points={{78,-50},{102,-50},{102,0}},color={0,0,127}));
  connect(informationRealBridge[6].y,telemetry.SAT_S0_busCurrent_A[3]) annotation(Line(points={{78,-50},{102,-50},{102,0}},color={0,0,127}));
  connect(SAT_S0_subArray_VPublisher[1],informationRealBridge[7].u) annotation(Line(points={{78,-40},{102,-40},{102,0}},color={0,0,127}));
  connect(informationRealBridge[7].y,telemetry.SAT_S0_subArray_V[1]) annotation(Line(points={{78,-40},{102,-40},{102,0}},color={0,0,127}));
  connect(SAT_S0_subArray_VPublisher[2],informationRealBridge[8].u) annotation(Line(points={{78,-40},{102,-40},{102,0}},color={0,0,127}));
  connect(informationRealBridge[8].y,telemetry.SAT_S0_subArray_V[2]) annotation(Line(points={{78,-40},{102,-40},{102,0}},color={0,0,127}));
  connect(SAT_S0_subArray_VPublisher[3],informationRealBridge[9].u) annotation(Line(points={{78,-40},{102,-40},{102,0}},color={0,0,127}));
  connect(informationRealBridge[9].y,telemetry.SAT_S0_subArray_V[3]) annotation(Line(points={{78,-40},{102,-40},{102,0}},color={0,0,127}));
  connect(SAT_S0_MPPT_VPublisher[1],informationRealBridge[10].u) annotation(Line(points={{78,-30},{102,-30},{102,0}},color={0,0,127}));
  connect(informationRealBridge[10].y,telemetry.SAT_S0_MPPT_V[1]) annotation(Line(points={{78,-30},{102,-30},{102,0}},color={0,0,127}));
  connect(SAT_S0_MPPT_VPublisher[2],informationRealBridge[11].u) annotation(Line(points={{78,-30},{102,-30},{102,0}},color={0,0,127}));
  connect(informationRealBridge[11].y,telemetry.SAT_S0_MPPT_V[2]) annotation(Line(points={{78,-30},{102,-30},{102,0}},color={0,0,127}));
  connect(SAT_S0_MPPT_VPublisher[3],informationRealBridge[12].u) annotation(Line(points={{78,-30},{102,-30},{102,0}},color={0,0,127}));
  connect(informationRealBridge[12].y,telemetry.SAT_S0_MPPT_V[3]) annotation(Line(points={{78,-30},{102,-30},{102,0}},color={0,0,127}));
  connect(SAT_S0_MPPT_APublisher[1],informationRealBridge[13].u) annotation(Line(points={{78,-20},{102,-20},{102,0}},color={0,0,127}));
  connect(informationRealBridge[13].y,telemetry.SAT_S0_MPPT_A[1]) annotation(Line(points={{78,-20},{102,-20},{102,0}},color={0,0,127}));
  connect(SAT_S0_MPPT_APublisher[2],informationRealBridge[14].u) annotation(Line(points={{78,-20},{102,-20},{102,0}},color={0,0,127}));
  connect(informationRealBridge[14].y,telemetry.SAT_S0_MPPT_A[2]) annotation(Line(points={{78,-20},{102,-20},{102,0}},color={0,0,127}));
  connect(SAT_S0_MPPT_APublisher[3],informationRealBridge[15].u) annotation(Line(points={{78,-20},{102,-20},{102,0}},color={0,0,127}));
  connect(informationRealBridge[15].y,telemetry.SAT_S0_MPPT_A[3]) annotation(Line(points={{78,-20},{102,-20},{102,0}},color={0,0,127}));
  connect(SAT_S0_charger_VPublisher[1],informationRealBridge[16].u) annotation(Line(points={{78,-10},{102,-10},{102,0}},color={0,0,127}));
  connect(informationRealBridge[16].y,telemetry.SAT_S0_charger_V[1]) annotation(Line(points={{78,-10},{102,-10},{102,0}},color={0,0,127}));
  connect(SAT_S0_charger_VPublisher[2],informationRealBridge[17].u) annotation(Line(points={{78,-10},{102,-10},{102,0}},color={0,0,127}));
  connect(informationRealBridge[17].y,telemetry.SAT_S0_charger_V[2]) annotation(Line(points={{78,-10},{102,-10},{102,0}},color={0,0,127}));
  connect(SAT_S0_charger_APublisher[1],informationRealBridge[18].u) annotation(Line(points={{78,0},{102,0},{102,0}},color={0,0,127}));
  connect(informationRealBridge[18].y,telemetry.SAT_S0_charger_A[1]) annotation(Line(points={{78,0},{102,0},{102,0}},color={0,0,127}));
  connect(SAT_S0_charger_APublisher[2],informationRealBridge[19].u) annotation(Line(points={{78,0},{102,0},{102,0}},color={0,0,127}));
  connect(informationRealBridge[19].y,telemetry.SAT_S0_charger_A[2]) annotation(Line(points={{78,0},{102,0},{102,0}},color={0,0,127}));
  connect(SAT_S0_batteryCurrent_APublisher,informationRealBridge[20].u) annotation(Line(points={{78,10},{102,10},{102,0}},color={0,0,127}));
  connect(informationRealBridge[20].y,telemetry.SAT_S0_batteryCurrent_A) annotation(Line(points={{78,10},{102,10},{102,0}},color={0,0,127}));
