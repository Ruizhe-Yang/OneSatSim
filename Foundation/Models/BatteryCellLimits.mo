within OneSatSim.Foundation.Models;
model BatteryCellLimits "Cell data and SOC operating-bound assertions"
  parameter Modelica.Electrical.Batteries.ParameterRecords.CellData cellData "任务级参数: 8.5 Ah per parallel cell" ;
  parameter Real SOCtolerance=1e-9 "配置项 SOCtolerance" ;
  Modelica.Blocks.Interfaces.RealInput u 
     "输入信号" annotation(Placement(visible=true, transformation(origin={-185,0}, extent={{-7,-7},{7,7}}, rotation=0), iconVisible=true, iconTransformation(origin={-89,0}, extent={{-5.76,-5.76},{5.76,5.76}}, rotation=0)));
equation
  assert(cellData.OCVmax > cellData.OCVmin,"Specify 0 <= OCVmin < OCVmax");
  assert(cellData.SOCmax > cellData.SOCmin,"Specify 0 <= SOCmin < SOCmax <= 1");
  assert(cellData.OCV_SOC[1,1] >= 0,"Specify OCV(SOC) table with minimum SOC >= 0");
  assert(cellData.OCV_SOC[end,1] <= 1,"Specify OCV(SOC) table with maximum SOC <= 1");
  assert(cellData.OCV_SOC[1,2] >= 0,"Specify OCV(SOC) table with minimum OCV/OCVmax >= 0");
  assert(cellData.OCV_SOC[end,2] <= 1,"Specify OCV(SOC) table with maximum OCV/OCVmax <= 1");
  assert(u < cellData.SOCmax + SOCtolerance,"Battery overcharged!");
  assert(u > cellData.SOCmin - SOCtolerance,"Battery exhausted!");
