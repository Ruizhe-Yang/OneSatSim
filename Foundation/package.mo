within NISSA_12UCubeSat;
package Foundation "基础建模包"
  extends Modelica.Icons.Package;
  annotation(Documentation(info="<html><h4>包职责</h4><p><b>定位：</b>提供连接器、必要方程核心、协议/工具函数和类型目录</p><p><b>内容：</b>Interfaces、Models、Functions、Types</p><p><b>推荐阅读：</b>先看Interfaces理解跨域语义，再看Models理解任务/环境/OBC遥测，Functions作为协议与工具参考</p><p><b>适用范围：</b>用于12U立方星多领域系统级总体仿真、架构理解、能量/热/姿态/任务联动和星上工程遥测导航。</p></html>"));
end Foundation;