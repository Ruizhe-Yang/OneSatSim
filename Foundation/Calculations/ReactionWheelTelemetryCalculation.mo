within OneSatSim.Foundation.Calculations;
model ReactionWheelTelemetryCalculation "反作用飞轮角动量与饱和状态计算"
  parameter Modelica.Units.SI.Inertia rotorInertia=1e-4 "飞轮转子惯量；Excel单位kg·m²，当前设计基线" ;
  parameter Modelica.Units.SI.AngularVelocity wheelSpeedLimit=628.3185307 "实际转子速度上限 [rad/s]" ;
  Modelica.Blocks.Interfaces.RealInput angularVelocity(unit="rad/s")  "计算/接口量 angularVelocity [rad/s]" annotation(Placement(visible=true, transformation(origin={-185,0}, extent={{-7,-7},{7,7}}, rotation=0), iconVisible=true, iconTransformation(origin={-89,0}, extent={{-5.76,-5.76},{5.76,5.76}}, rotation=0)));
  Modelica.Blocks.Interfaces.RealOutput momentum(unit="N.m.s")  "计算/接口量 momentum [N.m.s]" annotation(Placement(visible=true, transformation(origin={185,16}, extent={{-7,-7},{7,7}}, rotation=0), iconVisible=true, iconTransformation(origin={89,80}, extent={{-6,-6},{6,6}}, rotation=0)));
  Modelica.Blocks.Interfaces.BooleanOutput saturated  "计算/接口量 saturated" annotation(Placement(visible=true, transformation(origin={89,-80}, extent={{-16.909091,-16.909091},{16.909091,16.909091}}, rotation=0), iconVisible=true, iconTransformation(origin={89,-80}, extent={{-16.909091,-16.909091},{16.909091,16.909091}}, rotation=0)));
equation
  momentum=rotorInertia*angularVelocity;
  saturated=abs(angularVelocity) >= 0.98*wheelSpeedLimit;
  annotation(Documentation(info="<html><h2>反作用飞轮角动量与饱和状态计算</h2><p><b>类路径：</b><code>OneSatSim.Foundation.Calculations.ReactionWheelTelemetryCalculation</code>　<b>类型：</b>model</p><h3>用途与定位</h3><p>反作用飞轮角动量与饱和状态计算</p><h3>在工程中使用</h3><p>当前直接使用位置：<a href=\"modelica://OneSatSim.Components.ReactionWheelSUnit\">OneSatSim.Components.ReactionWheelSUnit</a> 的 <code>telemetryCalculation</code>；<a href=\"modelica://OneSatSim.Components.ReactionWheelXUnit\">OneSatSim.Components.ReactionWheelXUnit</a> 的 <code>telemetryCalculation</code>；<a href=\"modelica://OneSatSim.Components.ReactionWheelYUnit\">OneSatSim.Components.ReactionWheelYUnit</a> 的 <code>telemetryCalculation</code>；<a href=\"modelica://OneSatSim.Components.ReactionWheelZUnit\">OneSatSim.Components.ReactionWheelZUnit</a> 的 <code>telemetryCalculation</code>。</p><h3>接口、输入与输出</h3><table border=\"1\" cellspacing=\"0\" cellpadding=\"5\"><tr><th>名称/维数</th><th>类型</th><th>声明角色</th><th>单位</th><th>含义</th></tr><tr><td><code>angularVelocity</code></td><td>Modelica.Blocks.Interfaces.RealInput</td><td>public</td><td>rad/s</td><td>计算/接口量 angularVelocity [rad/s]</td></tr><tr><td><code>momentum</code></td><td>Modelica.Blocks.Interfaces.RealOutput</td><td>public</td><td>N.m.s</td><td>计算/接口量 momentum [N.m.s]</td></tr><tr><td><code>saturated</code></td><td>Modelica.Blocks.Interfaces.BooleanOutput</td><td>public</td><td>按声明/类型合同</td><td>计算/接口量 saturated</td></tr></table><h3>配置与参数</h3><p>下面列出当前源码表达式，仅用于阅读；当前参数对话框、生效配置记录与原有配置工具仍是使用依据。本页不新增默认值或换算。</p><table border=\"1\" cellspacing=\"0\" cellpadding=\"5\"><tr><th>参数</th><th>类型</th><th>用途</th><th>源码表达式</th></tr><tr><td><code>rotorInertia</code></td><td>Modelica.Units.SI.Inertia</td><td>飞轮转子惯量；Excel单位kg·m²，当前设计基线</td><td><code>=1e-4</code></td></tr><tr><td><code>wheelSpeedLimit</code></td><td>Modelica.Units.SI.AngularVelocity</td><td>实际转子速度上限 [rad/s]</td><td><code>=628.3185307</code></td></tr></table><h3>实现摘要</h3><p>以下表达式直接摘自本类，保留原始符号和单位体系；完整的条件分支、循环与初始化以源码为准。</p><pre>[equation] momentum=rotorInertia*angularVelocity;\n[equation] saturated=abs(angularVelocity) &gt;= 0.98*wheelSpeedLimit;</pre></html>"),
    Icon(coordinateSystem(extent={{-100,-100},{100,100}},preserveAspectRatio=true),graphics={
      Rectangle(extent={{-100,-100},{100,100}},fillPattern=FillPattern.Solid,fillColor={124,58,237},lineColor={124,58,237},lineThickness=0,radius=0),
      Rectangle(extent={{-53,-20},{53,48}},lineColor={255,255,255},fillColor={255,255,255},fillPattern=FillPattern.None,lineThickness=1.4,radius=0),
      Rectangle(extent={{-8,-42},{8,-20}},lineColor={255,255,255},fillColor={255,255,255},fillPattern=FillPattern.Solid,lineThickness=1.4,radius=0),
      Rectangle(extent={{-34,-52},{34,-42}},lineColor={255,255,255},fillColor={255,255,255},fillPattern=FillPattern.Solid,lineThickness=1.4,radius=0)
    }),
    Diagram(coordinateSystem(extent={{-100,-100},{100,100}},preserveAspectRatio=true),graphics={
      Rectangle(extent={{-100,-100},{100,100}},fillPattern=FillPattern.Solid,fillColor={124,58,237},lineColor={124,58,237},lineThickness=0,radius=0),
      Rectangle(extent={{-53,-20},{53,48}},lineColor={255,255,255},fillColor={255,255,255},fillPattern=FillPattern.None,lineThickness=1.4,radius=0),
      Rectangle(extent={{-8,-42},{8,-20}},lineColor={255,255,255},fillColor={255,255,255},fillPattern=FillPattern.Solid,lineThickness=1.4,radius=0),
      Rectangle(extent={{-34,-52},{34,-42}},lineColor={255,255,255},fillColor={255,255,255},fillPattern=FillPattern.Solid,lineThickness=1.4,radius=0)
    }));
end ReactionWheelTelemetryCalculation;