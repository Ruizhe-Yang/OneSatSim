within NISSA_12UCubeSat;
package Systems "系统集成包"
  extends Modelica.Icons.Package;
  annotation(Documentation(info="<html><h4>包职责</h4><p><b>定位：</b>实现1+4+8体系中的四个领域总体、八个专业分系统和整星总体</p><p><b>内容：</b>SpacecraftSystem、Four_systems、N_systems</p><p><b>推荐阅读：</b>先看SpacecraftSystem总图，再看Four_systems和N_systems</p><p><b>适用范围：</b>用于12U立方星多领域系统级总体仿真、架构理解、能量/热/姿态/任务联动和星上工程遥测导航。</p></html>"));
end Systems;