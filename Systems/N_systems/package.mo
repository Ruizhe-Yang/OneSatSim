within NISSA_12UCubeSat.Systems;
package N_systems "八个专业分系统包"
  annotation(Documentation(info="<html><h4>包职责</h4><p><b>定位：</b>按设备职责把Components组合为电源、姿轨控、载荷、数管、通信、导航、热控和结构分系统</p><p><b>内容：</b>8个纯连接白箱model</p><p><b>推荐阅读：</b>每个模型均查看Diagram连线与单组领域端口，随后下钻对应Components</p><p><b>适用范围：</b>用于12U立方星多领域系统级总体仿真、架构理解、能量/热/姿态/任务联动和星上工程遥测导航。</p></html>"));
end N_systems;