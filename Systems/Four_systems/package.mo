within NISSA_12UCubeSat.Systems;
package Four_systems "四个领域总体包"
  extends Modelica.Icons.Package;
  annotation(Documentation(info="<html><h4>包职责</h4><p><b>定位：</b>定义机械、电气、热学、信息四类公共总体网络</p><p><b>内容：</b>MechanicsOverall、ElectricalOverall、ThermalOverall、InformationOverall</p><p><b>推荐阅读：</b>InformationOverall用于理解数据链；MechanicsOverall用于理解环境；Electrical/Thermal用于理解公共物理网络</p><p><b>适用范围：</b>用于12U立方星多领域系统级总体仿真、架构理解、能量/热/姿态/任务联动和星上工程遥测导航。</p></html>"));
end Four_systems;