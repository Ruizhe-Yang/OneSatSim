package OneSatSim "12U立方星多领域系统级总体仿真模型库"
  extends Modelica.Icons.Package;
  annotation(version="2.1.0",uses(Modelica(version="4.0.0")),Documentation(info="<html><h4>包职责</h4><p><b>定位：</b>根包，组织基础层、场景层、设备层、系统层和唯一仿真入口。</p><p><b>内容：</b>Foundation、Scenarios、Components、Systems、Simulation；仅依赖Modelica 4.0.0。</p><p><b>推荐阅读：</b>建议依次阅读Simulation.CompleteMission、Scenarios、Systems.SpacecraftSystem、四个Overall、八个N-System、Components、Foundation.Interfaces/Models/Functions。</p><p><b>配置方法：</b>编辑根目录DesignConfig.xlsx并双击UpdateConfig.bat，随后运行Simulation.CompleteMission。</p></html>"));
end OneSatSim;
