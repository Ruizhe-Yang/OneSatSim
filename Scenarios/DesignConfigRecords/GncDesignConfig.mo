within OneSatSim.Scenarios.DesignConfigRecords;
record GncDesignConfig "gnc分系统设计配置"
  parameter ComputerComponentConfig computer "配置项 computer" ;
  parameter MagnetometerComponentConfig magnetometer "配置项 magnetometer" ;
  parameter MagnetorquerComponentConfig magnetorquer "配置项 magnetorquer" ;
  parameter MemsIMUComponentConfig memsIMU "配置项 memsIMU" ;
  parameter RateGyroComponentConfig rateGyro "速率Gyro" ;
  parameter StarYComponentConfig starY "配置项 starY" ;
  parameter StarZComponentConfig starZ "配置项 starZ" ;
  parameter SunSensorComponentConfig sunSensor "sun传感器" ;
  parameter WheelSComponentConfig wheelS "飞轮S" ;
  parameter WheelXComponentConfig wheelX "飞轮X" ;
  parameter WheelYComponentConfig wheelY "飞轮Y" ;
  parameter WheelZComponentConfig wheelZ "飞轮Z" ;
  annotation(Documentation(info="<html><h2>gnc分系统设计配置</h2><p><b>类路径：</b><code>OneSatSim.Scenarios.DesignConfigRecords.GncDesignConfig</code>　<b>类型：</b>record</p><h3>用途与定位</h3><p>gnc分系统设计配置</p><h3>配置与调用</h3><p>由使用者声明或传入本类型；记录与常量保存静态配置，不单独代表一套物理状态。修改设计输入后应通过项目既有离线配置入口生成生效快照。</p><h3>配置与参数</h3><p>下面列出当前源码表达式，仅用于阅读；当前参数对话框、生效配置记录与原有配置工具仍是使用依据。本页不新增默认值或换算。</p><table border=\"1\" cellspacing=\"0\" cellpadding=\"5\"><tr><th>参数</th><th>类型</th><th>用途</th><th>源码表达式</th></tr><tr><td><code>computer</code></td><td>ComputerComponentConfig</td><td>配置项 computer</td><td><code>由调用方、继承或默认声明提供</code></td></tr><tr><td><code>magnetometer</code></td><td>MagnetometerComponentConfig</td><td>配置项 magnetometer</td><td><code>由调用方、继承或默认声明提供</code></td></tr><tr><td><code>magnetorquer</code></td><td>MagnetorquerComponentConfig</td><td>配置项 magnetorquer</td><td><code>由调用方、继承或默认声明提供</code></td></tr><tr><td><code>memsIMU</code></td><td>MemsIMUComponentConfig</td><td>配置项 memsIMU</td><td><code>由调用方、继承或默认声明提供</code></td></tr><tr><td><code>rateGyro</code></td><td>RateGyroComponentConfig</td><td>速率Gyro</td><td><code>由调用方、继承或默认声明提供</code></td></tr><tr><td><code>starY</code></td><td>StarYComponentConfig</td><td>配置项 starY</td><td><code>由调用方、继承或默认声明提供</code></td></tr><tr><td><code>starZ</code></td><td>StarZComponentConfig</td><td>配置项 starZ</td><td><code>由调用方、继承或默认声明提供</code></td></tr><tr><td><code>sunSensor</code></td><td>SunSensorComponentConfig</td><td>sun传感器</td><td><code>由调用方、继承或默认声明提供</code></td></tr><tr><td><code>wheelS</code></td><td>WheelSComponentConfig</td><td>飞轮S</td><td><code>由调用方、继承或默认声明提供</code></td></tr><tr><td><code>wheelX</code></td><td>WheelXComponentConfig</td><td>飞轮X</td><td><code>由调用方、继承或默认声明提供</code></td></tr><tr><td><code>wheelY</code></td><td>WheelYComponentConfig</td><td>飞轮Y</td><td><code>由调用方、继承或默认声明提供</code></td></tr><tr><td><code>wheelZ</code></td><td>WheelZComponentConfig</td><td>飞轮Z</td><td><code>由调用方、继承或默认声明提供</code></td></tr></table></html>"),
