  annotation(Documentation(info="<html><h2>固定标准场景</h2><p><b>类路径：</b><code>OneSatSim.Scenarios.DefaultScenario</code>　<b>类型：</b>record</p><h3>用途与定位</h3><p>固定标准场景</p><h3>配置与调用</h3><p>由使用者声明或传入本类型；记录与常量保存静态配置，不单独代表一套物理状态。修改设计输入后应通过项目既有离线配置入口生成生效快照。</p><h3>继承与复用</h3><p>本类的继承/别名声明如下。继承得到的端口、参数、状态和算法仍由被引用类定义，不重复增加一套行为。</p><pre>ScenarioConfig( massProperties=GeneratedMassProperties(), operationalSnapshotStart=true, targetPredictionHorizon=84, earlyTargetPredictionHorizon=180, orbit=OrbitConfig( semiMajorAxis=6835361.4, eccentricity=0.002106700032949448, inclination=1.7005001741659893, initialRAAN=2.3704619932490054, initialMeanAnomaly=4.691670298595813, argumentOfPerigee=0, initialEpoch=0, stateInputMode=&quot;Cartesian&quot;, stateFrame=&quot;GCRS&quot;, simulationStartUTC=&quot;2026-10-01T00:00:00.000Z&quot;, stateEpochUTC=&quot;2026-10-01T00:00:00.000Z&quot;, inputPosition={-493801.273999,-752595.496556,-6776165.492715}, inputVelocity={-5490.252537677,5304.349223451,-172.811574358}, propagatedPositionAtStart={-493801.273999,-752595.496556,-6776165.492715}, propagatedVelocityAtStart={-5490.252537677,5304.349223451,-172.811574358}, referenceSemiMajorAxis=6835361.4, simulationDuration=86400, environmentSampleInterval=2.5, environmentTableRows=34563), initialConditions=InitialConditionConfig( roll=0, pitch=0.378712, yaw=0, wx=-3.3501e-5, wy=-7.2999e-5, wz=-1.6746e-5, batterySOC=0.8, batteryCellTemperature=279.91, batteryEnclosureTemperature=279.26, obcCpuTemperature=277.93, obcBoardTemperature=276.94, busDeckTemperature=275.14, externalShellTemperature=266.14, pcduBoardTemperature=288.36, cameraOpticalBenchTemperature=275.83, cameraFocalBoxTemperature=275.81, dataRecorderStoredBytes=38400000000, wheelSpeed={56.5,153.8,-161.6,-7.8}), groundStations={ GroundStationConfig(enabled=true,id=1,name=&quot;Beijing&quot;,latitude=0.70511301780570912,longitude …（完整表达式见源码）</pre></html>"),
